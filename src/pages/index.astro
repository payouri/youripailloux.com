---
import Base from "../layouts/Base.astro";
import { loadSite } from "../lib/site";

const site = loadSite();
---
<Base site={site} title={`${site.name} · ${site.role}`} description={site.claim.layer1}>
  <main class="landing" id="main">
    <a class="byline" href="/">
      <span class="byline__dot" aria-hidden="true"></span>
      <span data-byline>{site.name} · {site.role}</span>
    </a>
    <h1 class="claim" data-claim-layer-1>{site.claim.layer1}</h1>
  </main>
</Base>
