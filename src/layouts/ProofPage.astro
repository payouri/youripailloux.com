---
import Base from "./Base.astro";
import SectionMap from "../components/SectionMap.astro";
import { cardPath } from "../lib/card";
import { loadSite } from "../lib/site";
import { nextPage, supportLabel, type PageData, type ProofData } from "../lib/proof";

interface Heading { depth: number; slug: string; text: string }
interface Props { entry: PageData; list: ProofData[]; headings?: Heading[] }
const { entry, list, headings = [] } = Astro.props;
const site = loadSite();
const next = nextPage(list, entry);
// The section map lists the body's h2s, and only those.
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
---
<Base site={site} title={entry.title} description={entry.summary} card={cardPath(entry.slug)}>
  <main class="page" id="main" data-kind={entry.kind} data-slug={entry.slug}>
    <a class="byline" href="/">
      <span class="byline__dot" aria-hidden="true"></span>
      <span data-byline>{site.name} · {site.role}</span>
    </a>
    {sections.length > 0 && <SectionMap sections={sections} />}
    <article class="case">
      <h1 class="case__title" style={`view-transition-name: title-${entry.slug}`}>{entry.title}</h1>
      <p class="case__context" data-context>{entry.context.employer} · {entry.context.year}</p>
      <p class="case__support">{supportLabel[entry.support]}</p>
      <p class="case__summary" data-summary>{entry.summary}</p>
      {entry.kind === "tool" && (
        <dl class="tool" data-tool-facts>
          <div><dt>Friction it removes</dt><dd>{entry.friction}</dd></div>
          <div><dt>Who uses it</dt><dd>{entry.users}</dd></div>
          <div>
            <dt>ADRs</dt>
            <dd>
              <ul role="list">
                {entry.adrs.map((a) => <li><a href={a.href}>{a.title}</a></li>)}
              </ul>
            </dd>
          </div>
          <div><dt>Source</dt><dd><a href={entry.repo}>{entry.repo.replace(/^https?:\/\//, "")}</a></dd></div>
        </dl>
      )}
      <div class="prose" data-body><slot /></div>
      <p class="case__attribution" data-attribution>{entry.attribution}</p>
    </article>
    {next && (
      <nav class="next" aria-label="Next proof" data-reveal>
        <a href={`/${next.slug}`} data-next>
          <span class="next__label">Next</span>
          <span class="next__title">{next.title}<span class="next__arrow" aria-hidden="true">→</span></span>
        </a>
      </nav>
    )}
  </main>
</Base>
