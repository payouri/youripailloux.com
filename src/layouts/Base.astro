---
import "../styles/global.css";
import latin400 from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url";
import latin700 from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-700-normal.woff2?url";
import ContactBlock from "../components/ContactBlock.astro";
import { noindex } from "../lib/config";
import type { Site } from "../lib/site";

interface Props { site: Site; title: string; description: string; card: string }
const { site, title: pageTitle, description, card } = Astro.props;
const title = `${pageTitle} — ${site.name}`;
const cardUrl = new URL(card, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={latin400} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Runs before first paint so nothing flashes. Same query as src/scripts/reduced-motion.ts.
      // Motion is only armed when reduced motion is off; the intro only when this session hasn't seen it.
      (function () {
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var root = document.documentElement;
          root.dataset.reveal = "ready";
          if (!sessionStorage.getItem("intro-played")) root.dataset.intro = "pending";
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href={latin700} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="intro" data-intro-layer aria-hidden="true">
      <div class="intro__inner">
        <p class="intro__name">{site.name}</p>
        <ul class="intro__steps" role="list">
          <li>build <span>✓</span></li>
          <li>test <span>✓</span></li>
          <li>deploy <span>✓</span></li>
        </ul>
        <span class="intro__bar"></span>
      </div>
    </div>
    <slot />
    <ContactBlock site={site} />
    <script>import "../scripts/motion";</script>
  </body>
</html>
