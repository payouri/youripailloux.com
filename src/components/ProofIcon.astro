---
// Inline SVG, drawn with currentColor. A case study follows its support; a tool is
// always the package; a shelf item is always the file.
import type { ProofData } from "../lib/proof";
import { iconPaths, supportIcon } from "../lib/icons";
interface Props { entry: ProofData }
const { entry } = Astro.props;
const icon = entry.kind === "tool" ? "package" : entry.kind === "shelf" ? "file" : supportIcon[entry.support];
const size = entry.kind === "shelf" ? 19 : 24;
---
<svg class={`icon icon--${icon}`} data-icon={icon} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icon === "layers" && (<>
    {iconPaths.layers.map((d, i) => <path class={`l${3 - i}`} d={d} />)}
  </>)}
  {icon === "loop" && (<g class="loop">
    {iconPaths.loop.map((d) => <path d={d} />)}
  </g>)}
  {icon === "package" && (<g class="pkg">
    <path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z" />
    <path d="M3.5 7.5 12 12l8.5-4.5" />
    <path d="M12 12v9" />
  </g>)}
  {icon === "file" && (<>
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
    <path class="br-l" d="m10 12-2 2 2 2" />
    <path class="br-r" d="m14 12 2 2-2 2" />
  </>)}
</svg>
