---
import Base from "../layouts/Base.astro";
import ProofList from "../components/ProofList.astro";
import About from "../components/About.astro";
import { loadProof } from "../lib/loadProof";
import { homeCardPath } from "../lib/card";
import { loadSite } from "../lib/site";

const site = loadSite();
const proof = await loadProof();
---
<Base site={site} title={site.role} description={site.claim.layer1} card={homeCardPath}>
  <main id="main">
    <section class="landing" aria-label="Introduction">
      <a class="byline" href="/">
        <span class="byline__dot" aria-hidden="true"></span>
        <span data-byline>{site.name} · {site.role}</span>
      </a>
      <div class="claim">
        <h1 class="claim__layer-1" data-claim-layer-1 data-reveal>{site.claim.layer1}</h1>
        <p class="claim__layer-2" data-claim-layer-2 data-reveal>{site.claim.layer2}</p>
      </div>
    </section>
    <ProofList entries={proof} />
    <About site={site} />
  </main>
</Base>
